# Copy this file to ".env" and fill in your own values. Never commit ".env".

# MongoDB connection string.
#   Local MongoDB:  mongodb://127.0.0.1:27017/shopco
#   MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shopco?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/shopco

# Long random string used to sign login tokens. REQUIRED to be 32+ characters in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# How long a login stays valid (e.g. 7d, 12h).
JWT_EXPIRES_IN=7d

# Port the API listens on (hosting platforms like Render set this automatically).
PORT=5000

# Frontend URL(s) allowed to call this API (CORS). Comma-separate several.
# In production put your deployed frontend URL here, e.g. https://shop-co.vercel.app
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

# Max login/signup attempts per IP per 15 minutes.
AUTH_RATE_LIMIT_MAX=50

# Set to "production" when deployed.
NODE_ENV=development
